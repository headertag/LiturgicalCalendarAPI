# Dockerfile.mcp
FROM python:3.11-slim

WORKDIR /app

# Install MCP requirements
RUN pip install --no-cache-dir fastmcp

# Copy the static data generated during the CI build
COPY dist/ /app/dist/
# Copy the MCP server script (preserve scripts/ layout so DIST_DIR resolves correctly)
COPY scripts/mcp_server.py /app/scripts/mcp_server.py

# Expose port for Fly.io
EXPOSE 8080

# Run the MCP server via Streamable HTTP (2025-03-26 spec) with CORS enabled.
# Endpoint: /mcp
CMD ["python", "scripts/mcp_server.py"]
